
#include<iostream>
#include<iomanip>
#include<cmath>

using namespace std;


int main()
{
    int macierz[3][3];
	cout << "Podaj elementy jakie chcesz w tabeli: ";

	for (int i = 0; i < 3; i++)
	{
		for (int j = 0; j < 3; j++)
		{
			cout << "Element [" << i << "][" << j << "]: ";
			cin >> macierz[i][j];
		}
	}
	cout << "Tabelka: " << endl;

	for (int i = 0; i < 3; i++)
	{
		cout << "|";
		for (int j = 0; j < 3; j++)
		{
			cout << macierz[i][j] << " ";
		}
		cout << "|\n";
	}
	
    return 0;
}
